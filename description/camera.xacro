<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- parameters: camera_offset_x
                     camera_offset_z -->

    <joint name="camera_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="camera_link"/>
        <origin xyz="${camera_offset_x} 0 ${camera_offset_z}" rpy="0 0.18 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="sensor_blue"/>
        </visual>
        <visual>
            <origin xyz="0 0 -0.05"/>
            <geometry>
                <cylinder radius="0.002" length="0.1"/>
            </geometry>
            <material name="sensor_blue"/>
        </visual>
    </link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="camera_link_optical">
    </link>

    <!-- gz model -m dragger -s rgb_camera -->
    <gazebo reference="camera_link_optical">
      <sensor name="rgb_camera" type="camera">

        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>

        <topic>/gz_camera</topic>
        <camera_info_topic>/gz_camera/camera_info</camera_info_topic>

        <camera>
          <!-- "Arducam 8MP IMX219 Camera Module for Raspberry Pi, with Low Distortion 105°(D) FOV M12 Lens"
                a 105° diagonal FOV corresponds approximately to:
                  - Horizontal: ≈ 88–90°
                  - Vertical: ≈ 66–68°
                  - 1.56 rad ≈ 89.4° -->
          <horizontal_fov>1.56</horizontal_fov>

          <image>
            <!-- Use reasonable frame size 820x616 for fast transmission and rendering -->
            <width>820</width>
            <height>616</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>

          <optical_frame_id>camera_link_optical</optical_frame_id>
        </camera>

      </sensor>
    </gazebo>

</robot>