<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- See:
             - https://github.com/slgrobotics/ros2_inference_stereo/blob/main/README.md
             - https://github.com/slgrobotics/articubot_one/wiki/Visual-SLAM-with-RTAB%E2%80%90Map
    -->

    <!-- parameters: camera_oakd_offset_x
                     camera_oakd_offset_z -->

    <joint name="camera_oakd_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="camera_oakd_link"/>
        <origin xyz="${camera_oakd_offset_x} 0 ${camera_oakd_offset_z}" rpy="0 0 0"/>
    </joint>

    <link name="camera_oakd_link">
        <visual>
            <geometry>
                <box size="0.018 0.095 0.03"/>
            </geometry>
            <material name="sensor_blue"/>
        </visual>
        <visual name="stereo_camera_visual_lens_center">
            <origin xyz="0.010 0 0.005" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.006" length="0.002"/>
            </geometry>
            <material name="sensor_blue"/>
        </visual>
        <visual name="stereo_camera_visual_lens_right">
            <origin xyz="0.010 -0.035 0.005" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.006" length="0.004"/>
            </geometry>
            <material name="sensor_lens_blue"/>
        </visual>
        <visual name="stereo_camera_visual_lens_left">
            <origin xyz="0.010 0.035 0.005" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.006" length="0.004"/>
            </geometry>
            <material name="sensor_lens_blue"/>
        </visual>
    </link>

    <!--  The Optical Coordinate System (For Cameras and Sensors)
      Cameras view the world from a pixel grid perspective rather than a driving perspective.
      Because of this, REP-103 defines a completely different axis standard for optical frames:
      When looking out through the camera lens:
        - Z-Axis: Points Forward (into the scene, acting as the Depth axis)
        - X-Axis: Points Right   (horizontal pixel axis)
        - Y-Axis: Points Down    (vertical pixel axis)
      RTAB-Map relies on this standard to calculate visual odometry and project depth pixels into a 3D world
      So, we use <optical_frame_id>camera_oakd_link_optical</optical_frame_id> to force frame_id in message headers.
    -->

    <joint name="camera_oakd_optical_joint" type="fixed">
        <parent link="camera_oakd_link"/>
        <child link="camera_oakd_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <xacro:if value="$(arg sim_mode)">
      <!-- OAK-D depthai_descr.urdf.xacro generates its own "parent_frame", in our case we want it to be "depth_camera_link_optical" -->
      <link name="camera_oakd_link_optical">
      </link>
    </xacro:if>

    <!-- REP-103 defines a Right-Handed, Z-Up coordinate system.
        - X-Axis (Red in RViz):   Points Forward (the direction the robot drives)
        - Y-Axis (Green in RViz): Points Left
        - Z-Axis (Blue in RViz):  Points Up (against gravity)
      The Gazebo camera is operating in that frame, with no rotation needed (uses camera_oakd_link)
    -->

    <!-- gz model -m seggy -s rgbd_camera -->
    <gazebo reference="camera_oakd_link">
      <!-- This sensor type is optimized for use with RTAB-Map on Dragger and Seggy robots
           See https://github.com/slgrobotics/articubot_one/wiki/Visual-SLAM-with-RTAB%E2%80%90Map
               https://github.com/slgrobotics/ros2_inference_stereo -->
      <sensor name="rgbd_camera" type="rgbd">

        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>

        <topic>/gz_camera_oakd</topic>
        <camera_info_topic>/gz_camera_oakd/camera_info</camera_info_topic>

        <camera>

           <!-- ~69 degrees DFoV -->
          <horizontal_fov>1.204</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.2</near>
            <far>19.1</far>
          </clip>

          <optical_frame_id>camera_oakd_link_optical</optical_frame_id>

          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.003</stddev>
          </noise>

        </camera>

      </sensor>
    </gazebo>

</robot>