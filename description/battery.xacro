<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

  <!-- ********************* The Battery (Power System) SETUP *********************************  -->

  <!-- See https://docs.ros.org/en/lyrical/p/battery_state_broadcaster/
           https://github.com/gazebosim/ros_gz/blob/ros2/ros_gz_sim_demos/README.md
           /opt/ros/${ROS_DISTRO}/opt/gz_sim_vendor/share/gz/gz-sim/worlds/linear_battery_demo.sdf
           /opt/ros/${ROS_DISTRO}/share/ros_gz_sim_demos
           https://gazebosim.org/api/sim/10/classgz_1_1sim_1_1systems_1_1LinearBatteryPlugin.html

      Note: This is a generic SIM battery. Copy to robots/<robot_model>/description/. and customize.
            Modify robot.urdf.xacro to include the customized version.

      parameters: open_circuit_voltage
                  battery_capacity
                  power_load (W)
  -->

  <!-- Included inside the real drive system's ros2_control element. Gazebo
       publishes BatteryState through ros_gz_bridge instead of this broadcaster. -->
  <xacro:macro name="battery_state_interfaces" params="battery_name:=main_battery">
    <sensor name="${battery_name}">
      <state_interface name="battery_voltage"/>
      <state_interface name="battery_temperature"/>
      <state_interface name="battery_current"/>
      <state_interface name="battery_charge"/>
      <state_interface name="battery_percentage"/>
      <state_interface name="battery_power_supply_status"/>
      <state_interface name="battery_power_supply_health"/>
      <state_interface name="battery_present" data_type="bool"/>
    </sensor>
  </xacro:macro>

  <xacro:if value="$(arg sim_mode)">
  <gazebo>
    <plugin name="gz::sim::systems::LinearBatteryPlugin" filename="gz-sim-linearbatteryplugin-system">
      <!--Li-ion battery spec from LIR18650 datasheet-->
      <battery_name>lithium_battery</battery_name>
      <voltage>${open_circuit_voltage}</voltage>
      <open_circuit_voltage_constant_coef>${open_circuit_voltage}</open_circuit_voltage_constant_coef>
      <open_circuit_voltage_linear_coef>-2.0</open_circuit_voltage_linear_coef>
      <initial_charge>${battery_capacity * 0.9}</initial_charge>
      <capacity>${battery_capacity}</capacity>
      <power_load>${power_load}</power_load>
      <resistance>0.07</resistance>
      <smooth_current_tau>2.0</smooth_current_tau>
      <!-- ros_gz_bridge forwards percentage unchanged. Keep false for ROS's 0..1
           range. True uses charge / capacity and publishes it on a 0..100 scale. -->
      <fix_issue_225>false</fix_issue_225>
      <!-- ROS BatteryState uses negative current during discharge. -->
      <invert_current_sign>true</invert_current_sign>
      <enable_recharge>true</enable_recharge>
      <!-- charging I = c / t, discharging I = P / V,
        charging I should be > discharging I -->
      <charging_time>3.0</charging_time>
      <recharge_by_topic>true</recharge_by_topic>
      <!-- Start draining on the first nonzero joint velocity or force command. -->
      <start_draining>false</start_draining>
    </plugin>
  </gazebo>
  </xacro:if>

</robot>
