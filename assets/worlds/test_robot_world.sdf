    </model>

    <!-- 
        "<scale>0.3 0.3 0.3</scale>" - this does not work for included models
        see http://models.gazebosim.org/construction_cone/
            original cone scale is 10, mine is 6 -->
    <include>
      <!-- <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Construction Cone</uri> -->
      <uri>model://models/construction_cone</uri>
      <name>Construction Cone One</name>
      <pose>4 1.2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://models/construction_cone</uri>
      <name>Construction Cone Two</name>
      <pose>5 5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://models/construction_cone</uri>
      <name>Construction Cone Three</name>
      <pose>-3 7 0 0 0 0</pose>
    </include>
    <!-- include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Construction Barrel</uri>
      <name>Construction Barrel One</name>
      <pose>5 -1 0 0 0 0</pose>
    </include -->
    <!-- include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>Standing Person One</name>
      <pose>6 0 0 0 0 0</pose>
    </include -->

    <model name="pyramid">
      <pose>3.0 5.0 0.0 0 0 0</pose>

      <link name="pyramid_link">
        <pose>0 0 0 0 0 0</pose>

        <inertial>
          <mass>50.0</mass>
          <!-- Optional: inertial pose, leave at 0 unless you know it -->
          <inertia>
            <ixx>20.0</ixx> <ixy>0</ixy> <ixz>0</ixz>
            <iyy>20.0</iyy> <iyz>0</iyz>
            <izz>10.0</izz>
          </inertia>
        </inertial>

        <visual name="pyramid_vis_gz">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://meshes/pyramid.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 1.0 0.8 1</ambient>
            <diffuse>1.0 1.0 0.8 1</diffuse>
          </material>
       </visual>

        <collision name="pyramid_coll">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://meshes/pyramid.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Seggy reverse-docking practice bay (visual markings only; no collisions).
         Origin: requested final robot XY pose; +X is the parked robot's forward
         direction (yaw 0.717822238473 rad). Approach from +X and reverse toward
         the green origin cross. Blue cross: staging reference 0.8 m ahead.
         These are Gazebo world coordinates; verify map/world alignment before
         using this location in a Nav2 dock database. No charging is simulated. -->
    <model name="seggy_docking_area">
      <static>true</static>
      <pose>-1 3 0 0 0 0</pose>
      <link name="markings">
        <visual name="bay_floor">
          <pose>0.5 0 0.002 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>1.8 1.0 0.004</size></box></geometry>
          <material>
            <ambient>0.08 0.16 0.22 1</ambient>
            <diffuse>0.08 0.16 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="left_boundary">
          <pose>0.5 0.5 0.006 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>1.8 0.035 0.004</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="right_boundary">
          <pose>0.5 -0.5 0.006 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>1.8 0.035 0.004</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="rear_boundary">
          <pose>-0.4 0 0.006 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.035 1.0 0.004</size></box></geometry>
          <material>
            <ambient>1 0.8 0.05 1</ambient>
            <diffuse>1 0.8 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="target_cross_x">
          <pose>0 0 0.009 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.3 0.025 0.004</size></box></geometry>
          <material>
            <ambient>0.1 1 0.3 1</ambient>
            <diffuse>0.1 1 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="target_cross_y">
          <pose>0 0 0.009 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.025 0.3 0.004</size></box></geometry>
          <material>
            <ambient>0.1 1 0.3 1</ambient>
            <diffuse>0.1 1 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="staging_cross_x">
          <pose>0.8 0 0.009 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.3 0.025 0.004</size></box></geometry>
          <material>
            <ambient>0.1 0.8 1 1</ambient>
            <diffuse>0.1 0.8 1 1</diffuse>
          </material>
        </visual>
        <visual name="staging_cross_y">
          <pose>0.8 0 0.009 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.025 0.3 0.004</size></box></geometry>
          <material>
            <ambient>0.1 0.8 1 1</ambient>
            <diffuse>0.1 0.8 1 1</diffuse>
          </material>
        </visual>
        <visual name="reverse_arrow_shaft">
          <pose>0.43 0 0.009 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.28 0.035 0.004</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <visual name="reverse_arrow_left">
          <pose>0.33 0.045 0.009 0 0 -0.7853981634</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.15 0.035 0.004</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <visual name="reverse_arrow_right">
          <pose>0.33 -0.045 0.009 0 0 0.7853981634</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.15 0.035 0.004</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='dock-bay-wall-1'>
      <pose>-1.25 2.45 0.25 0 0 0</pose>
      <link name='wall_4_link'>
        <inertial>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
          <mass>100</mass>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name='dock-bay-wall-1_collision'>
          <geometry>
            <box>
              <size>0.45 0.05 0.5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='dock-bay-wall-1_visual'>
          <geometry>
            <box>
              <size>0.45 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <model name='dock-bay-wall-2'>
      <pose>-1.45 3.0 0.25 0 0 1.5708</pose>
      <link name='wall_4_link'>
        <inertial>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
          <mass>100</mass>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name='dock-bay-wall-2_collision'>
          <geometry>
            <box>
              <size>1.05 0.05 0.5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='dock-bay-wall-2_visual'>
          <geometry>
            <box>
              <size>1.05 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <model name='dock-bay-wall-3'>
      <pose>-1.25 3.55 0.25 0 0 0</pose>
      <link name='wall_4_link'>
        <inertial>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
          <mass>100</mass>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name='dock-bay-wall-3_collision'>
          <geometry>
            <box>
              <size>0.45 0.05 0.5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='dock-bay-wall-3_visual'>
          <geometry>
            <box>
              <size>0.45 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <!-- Main sun -->
    <light name="sun" type="directional">
      <!-- Pose doesn't matter much for directional, keep it simple -->
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>

      <!-- Sun direction: slightly from the side, downward -->
      <direction>0.2 0.4 -0.9</direction>

      <!-- Slightly warm sunlight -->
      <diffuse>1.0 0.98 0.92 1</diffuse>

      <!-- Keep specular modest to avoid a “plastic” look -->
      <specular>0.12 0.12 0.12 1</specular>
    </light>

    <!-- Sky fill (soft ambient-ish lift) -->
    <light name="sky_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <intensity>0.35</intensity>

      <!-- From above-ish but different angle than sun -->
      <direction>-0.2 -0.1 -0.98</direction>

      <!-- Cool-ish skylight -->
      <diffuse>0.80 0.86 1.0 1</diffuse>
      <specular>0 0 0 1</specular>
    </light>

  </world>
</sdf>
