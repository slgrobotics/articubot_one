<!--
  Patrol behavior tree — mission-level executor
  Runs in patrol_commander (NOT in bt_navigator)

  Architecture per patrol point:
    Fallback
    ├── ReactiveSequence             navigate unless object interrupts
    │   ├── Inverter(DetectObject)   SUCCESS = clear, FAILURE = object found
    │   └── NavigateToRoom           halted via onHalted() when Inverter fails
    ├── ApproachObject               runs when object interrupted nav
    └── Sequence                     nav failed, no object -> recover
        ├── RecoveryRotate           360 spin to re-localize
        └── WaitAndRetry             2s wait, returns FAILURE to trigger retry

  Top-level: CheckBattery gates the patrol loop.
  A low battery starts docking, charging, and undocking.
-->

<root BTCPP_format="4">
  <BehaviorTree ID="PatrolTree">
    <Fallback>
      <ReactiveSequence>
        <CheckBattery/>
        <Sequence name="Patrol">

          <!-- Patrol point 1 in the four_rooms map -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="0.6471121311187744" y="2.7072768211364746"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Patrol point 2 in the four_rooms map -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="2.5293877124786377" y="5.790807247161865"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Patrol point 3 in the four_rooms map -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="7.029889106750488" y="6.96327018737793"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Patrol point 4 in the four_rooms map -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="6.157336235046387" y="1.648167371749878"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Patrol point 5 in the four_rooms map -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="2.81367564201355" y="-4.646635055541992"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Patrol point 6 in the four_rooms map -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="-4.457201957702637" y="3.5339748859405518"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

        </Sequence>
      </ReactiveSequence>
      <!-- Hold patrol until docking, charging, and undocking complete -->
      <ChargeBattery/>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="CheckBattery"/>
    <Condition ID="DetectObject">
      <input_port name="target"/>
      <output_port name="object_pose"/>
    </Condition>
    <Action ID="ApproachObject">
      <input_port name="target_pose"/>
    </Action>
    <Action ID="NavigateToRoom">
      <input_port name="x"/>
      <input_port name="y"/>
    </Action>
    <Action ID="RecoveryRotate"/>
    <Action ID="WaitAndRetry"/>
    <Action ID="ChargeBattery"/>
  </TreeNodesModel>
</root>