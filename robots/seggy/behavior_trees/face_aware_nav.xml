<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="CustomNavTree">
  <!-- Requires the default data-pump build of slg_bt_plugins.
       This is Seggy's configured BT Navigator NavigateToPose tree.
       STOP cancels the goal; face detection pauses translation and turns. -->


  <!--
  see https://github.com/slgrobotics/articubot_one/wiki/Behavior-Tree-for-Gesture-and-Face-Detection-Sensor
      https://github.com/slgrobotics/face_gesture_sensor
      https://github.com/slgrobotics/slg_bt_plugins

  What this tree does:

      Normal navigation by default
          Uses Nav2 default "navigate_to_pose_w_replanning_and_recovery.xml" tree
          Tree behaves exactly like stock Nav2

      STOP gesture detected
          Requests cancellation of the current Nav2 goal; retries failures
          Clearing STOP does not resume this goal; send a new goal after cancellation
          Works even while robot is moving/navigating

      Face detected
          Robot turns toward the person
          Holds navigation while the face remains detected; alignment alone does not complete the goal
          Falls back to default navigation if face is lost

      No face in view
          Robot continues with default navigation unless STOP already requested cancellation

  To use this tree, edit config/nav2_params.yaml:
     default_nav_to_pose_bt_xml: "$(find-pkg-share articubot_one)/robots/seggy/behavior_trees/face_aware_nav.xml"

  It will start executing once you set "Nav2 Goal" via RViz or programmatically.
  -->


  <!-- Include the default Nav2 tree - usually seen in "nav2_params.yaml":
           default_nav_to_pose_bt_xml: "$(find-pkg-share nav2_bt_navigator)/behavior_trees/navigate_to_pose_w_replanning_and_recovery.xml"
  -->
  <include ros_pkg="nav2_bt_navigator" path="behavior_trees/navigate_to_pose_w_replanning_and_recovery.xml"/>

  <!-- Give YOUR root tree a unique ID like "CustomNavTree" -->
  <BehaviorTree ID="CustomNavTree">
    <!-- ReactiveSequence refreshes perception before the selected behavior on
         every tick, including while navigation, turning, or cancellation runs.
         Navigation SUCCESS/FAILURE reaches the root without a background loop
         masking the result. -->
    <ReactiveSequence name="PumpAndNavigate">
      <FgsTopicToBlackboard
        topic_name="/bt/face_gesture_detect"
        is_face_detected="{is_face_detected}"
        face_yaw_error="{face_yaw_error}"
        gesture="{gesture}"
        is_stop_gesture="{is_stop_gesture}"
        is_like_gesture="{is_like_gesture}"
        is_ok_gesture="{is_ok_gesture}"
        is_yes_gesture="{is_yes_gesture}"
        is_six_gesture="{is_six_gesture}"
      />
      <ReactiveFallback name="CancelOrTurnOrNavigate">
        <!-- Sequence remembers STOP once detected, even if the gesture clears.
             Retry cancellation without resuming motion. Stay RUNNING after
             acceptance until the navigator processes its cancellation request. -->
        <Sequence name="CancelOnStop">
          <IsStopGesture is_stop_gesture="{is_stop_gesture}"/>
          <RetryUntilSuccessful num_attempts="-1">
            <CancelNavToPose action_name="navigate_to_pose" timeout_ms="500"/>
          </RetryUntilSuccessful>
          <KeepRunningUntilFailure>
            <AlwaysSuccess/>
          </KeepRunningUntilFailure>
        </Sequence>
        <!-- Alignment also remains RUNNING so it cannot report goal success.
             Recheck the face every tick and resume navigation when it disappears. -->
        <ReactiveSequence name="PauseAndTurnWhileFaceDetected">
          <IsFaceDetected is_face_detected="{is_face_detected}"/>
          <KeepRunningUntilFailure>
            <TurnTowardFace angle_tolerance="0.1" max_turn_rate="0.5" is_face_detected="{is_face_detected}" face_yaw_error="{face_yaw_error}"/>
          </KeepRunningUntilFailure>
        </ReactiveSequence>
        <SubTree ID="NavigateToPoseWReplanningAndRecovery" _autoremap="true"/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
