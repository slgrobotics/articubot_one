<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="DraggerRobot" type="system">

        <!-- Wheel geometry information - see controllers.yaml -->

        <hardware>
            <xacro:unless value="$(arg sim_mode)">
                <!-- Load only for real hardware; simulation needs no hardware YAML. -->
                <xacro:property name="hw" value="${xacro.load_yaml('$(arg hardware_config)')}"/>
                <plugin>diffdrive_arduino/DiffDriveArduino</plugin>
                <param name="left_wheel_name">left_wheel_joint</param>
                <param name="right_wheel_name">right_wheel_joint</param>
                <param name="loop_rate">30</param>
                <param name="device">${hw['device']}</param>
                <param name="baud_rate">${hw['baud_rate']}</param>
                <param name="timeout">${hw['timeout']}</param>
                <param name="enc_counts_per_rev">${hw['enc_counts_per_rev']}</param>
                <param name="wheels_pwm_factor">${hw['wheels_pwm_factor']}</param>
                <!-- See https://github.com/slgrobotics/articubot_one/wiki/Jazzy-to-Lyrical-migration#battery-monitoring -->
                <param name="battery_name">main_battery</param>
                <param name="battery_num_cells">${hw['battery_num_cells']}</param>
                <param name="battery_technology">${hw['battery_technology']}</param>
                <param name="battery_design_capacity">${hw['battery_design_capacity']}</param>
                <!-- A workaround for sonar no-return ".inf" values 
                 Set sonar_broadcaster's max_range: 5.1 in robots/dragger/config/controllers.yaml
                 Proper fix woild be in Nav2 Collision Monitor code to accept .inf values
                 See https://github.com/slgrobotics/articubot_one/wiki/Jazzy-to-Lyrical-migration#sonars-inf-problem-in-collision-monitor -->
                <!-- param name="sonar_no_return_range">5.0</param -->
            </xacro:unless>

            <xacro:if value="$(arg sim_mode)">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
        </hardware>

        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <!-- state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface -->
        </joint>

        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <!-- state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface -->
        </joint>

        <xacro:if value="$(arg sim_mode)">
            <!-- we need this for Rviz to reflect rotations of joints published by broad_cont in Gazebo -->
            <joint name="left_caster_wheel_joint">
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            <joint name="right_caster_wheel_joint">
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
        </xacro:if>

        <xacro:unless value="$(arg sim_mode)">
            <xacro:battery_state_interfaces battery_name="main_battery"/>
        </xacro:unless>

    </ros2_control>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <!-- the following are just default parameters anyway. Skip them unless you want to reassign them:
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node> -->

            <parameters>$(find articubot_one)/robots/dragger/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
